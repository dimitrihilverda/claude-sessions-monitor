# Personal data and working files -- these do not belong in a repo, not even
# a private one. They contain your calendar, your inbox and your session prompts.
dashboard.html
sessions.js
sessions.json
session-status/
snooze.json
actions.log
hud-config.json
taak-prompt.txt

# The installable package. build-pakket.py produces it, and CI attaches it to
# each release -- so a copy in the repo could only ever be a stale one.
ClaudeDeck.zip

# Compiler output. arduino-cli and the Arduino IDE drop this next to the sketch,
# and a .map plus a .elf are 16 MB each -- they have no business in a repo. The
# GitHub Actions workflow builds the firmware for the web flasher instead.
cyd/**/build/
*.elf
*.map

# temporary files from the atomic write
*.tmp

# Windows / editors
Thumbs.db
desktop.ini
.vs/
.idea/
__pycache__/
